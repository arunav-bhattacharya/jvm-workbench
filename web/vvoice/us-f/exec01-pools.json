 "max_late": 0.17,
 "groups": [
  {
   "cue": 2.7,
   "start": 2.7,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 2.35,
   "tries": 1,
   "text": "Your service has five thousand tiny tasks."
  },
  {
   "cue": 5.03,
   "start": 5.2,
   "late": 0.17,
   "tempo": 1.0,
   "secs": 3.59,
   "tries": 1,
   "text": "Run each one on a brand-new thread, and look at what one costs."
  },
  {
   "cue": 9.57,
   "start": 9.57,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 5.85,
   "tries": 1,
   "text": "Starting a platform thread means a system call to the O S, a new stack, and an entry in the O S scheduler."
  },
  {
   "cue": 16.9,
   "start": 16.9,
   "late": 0.0,
   "tempo": 1.142,
   "secs": 2.52,
   "tries": 1,
   "text": "Then the task runs, for a few microseconds."
  },
  {
   "cue": 19.62,
   "start": 19.62,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.92,
   "tries": 3,
   "text": "Then all of it is torn down again."
  },
  {
   "cue": 22.0,
   "start": 22.0,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.23,
   "tries": 1,
   "text": "Most of that time goes to the thread, not the work."
  },
  {
   "cue": 25.48,
   "start": 25.48,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 4.38,
   "tries": 1,
   "text": "Now do it five thousand times, and compare four threads that are kept and reused."
  },
  {
   "cue": 30.47,
   "start": 30.47,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.2,
   "tries": 2,
   "text": "How big is the gap?"
  },
  {
   "cue": 33.4,
   "start": 33.4,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 4.45,
   "tries": 1,
   "text": "On a four-core machine: half a second to a second and a half with a new thread each time."
  },
  {
   "cue": 39.98,
   "start": 39.98,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.2,
   "tries": 1,
   "text": "six to twenty-five ms on four reused threads."
  },
  {
   "cue": 43.5,
   "start": 43.5,
   "late": 0.0,
   "tempo": 1.081,
   "secs": 1.39,
   "tries": 1,
   "text": "A thread pool fixes this."
  },
  {
   "cue": 45.1,
   "start": 45.1,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.47,
   "tries": 1,
   "text": "It starts a few threads once, and keeps them."
  },
  {
   "cue": 48.2,
   "start": 48.2,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 1.32,
   "tries": 1,
   "text": "Tasks go into a queue."
  },
  {
   "cue": 49.69,
   "start": 49.69,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 4.82,
   "tries": 1,
   "text": "Each worker runs one loop: take a task, run it, take the next."
  },
  {
   "cue": 54.8,
   "start": 54.8,
   "late": 0.0,
   "tempo": 1.104,
   "secs": 2.67,
   "tries": 1,
   "text": "Four workers, so at most four tasks run at once."
  },
  {
   "cue": 57.69,
   "start": 57.69,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.72,
   "tries": 1,
   "text": "When the queue is empty, take blocks, and they wait."
  },
  {
   "cue": 61.03,
   "start": 61.03,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.39,
   "tries": 1,
   "text": "Now the service is stopping."
  },
  {
   "cue": 62.84,
   "start": 62.84,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.49,
   "tries": 1,
   "text": "Five tasks are queued, and four are running."
  },
  {
   "cue": 65.9,
   "start": 65.9,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 1.26,
   "tries": 1,
   "text": "main calls shutdown."
  },
  {
   "cue": 67.29,
   "start": 67.31,
   "late": 0.02,
   "tempo": 1.0,
   "secs": 1.57,
   "tries": 1,
   "text": "Does it wait for those tasks?"
  },
  {
   "cue": 71.13,
   "start": 71.13,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.21,
   "tries": 1,
   "text": "No. shutdown closes the door and returns at once."
  },
  {
   "cue": 75.03,
   "start": 75.03,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.61,
   "tries": 1,
   "text": "A new task is rejected."
  },
  {
   "cue": 77.1,
   "start": 77.1,
   "late": 0.0,
   "tempo": 1.009,
   "secs": 2.47,
   "tries": 1,
   "text": "The queued and running tasks still finish."
  },
  {
   "cue": 79.7,
   "start": 79.72,
   "late": 0.02,
   "tempo": 1.014,
   "secs": 3.84,
   "tries": 1,
   "text": "To wait for that, main calls awaitTermination, with a timeout."
  },
  {
   "cue": 83.77,
   "start": 83.77,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 5.2,
   "tries": 1,
   "text": "When the last worker exits, the pool is terminated, and awaitTermination returns true."
  },
  {
   "cue": 89.47,
   "start": 89.47,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.96,
   "tries": 1,
   "text": "If the timeout runs out first, it returns false."
  },
  {
   "cue": 93.67,
   "start": 93.67,
   "late": 0.0,
   "tempo": 1.061,
   "secs": 1.73,
   "tries": 1,
   "text": "shutdownNow is the hard stop."
  },
  {
   "cue": 95.62,
   "start": 95.62,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 5.04,
   "tries": 1,
   "text": "It closes the door, empties the queue, and hands back the five tasks that never ran."
  },
  {
   "cue": 101.5,
   "start": 101.5,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.25,
   "tries": 1,
   "text": "Then it interrupts the four running tasks."
  },
  {
   "cue": 104.04,
   "start": 104.04,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 1.77,
   "tries": 1,
   "text": "An interrupt is only a request."
