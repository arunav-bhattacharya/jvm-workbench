   "start": 119.6,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 5.99,
   "tries": 1,
   "text": "Rule one point three: signals come one at a time, so a subscriber needs no locks for its own fields."
  },
  {
   "cue": 126.63,
   "start": 126.63,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.79,
   "tries": 1,
   "text": "And rule two point one three: a subscriber that wants to stop calls cancel."
