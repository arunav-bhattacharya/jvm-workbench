 "groups": [
  {
   "cue": 2.7,
   "start": 2.7,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.36,
   "tries": 1,
   "text": "Java's own streams are built in layers."
  },
  {
   "cue": 5.37,
   "start": 5.37,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.57,
   "tries": 1,
   "text": "Start with the real stream."
  },
  {
   "cue": 7.21,
   "start": 7.21,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 5.02,
   "tries": 1,
   "text": "Wrap it in a GZIPOutputStream, then a BufferedOutputStream, then a DataOutputStream."
  },
  {
   "cue": 13.17,
   "start": 13.17,
   "late": 0.0,
   "tempo": 1.047,
   "secs": 1.98,
   "tries": 1,
   "text": "Each wrapper is an OutputStream too."
  },
  {
   "cue": 15.37,
   "start": 15.37,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.74,
   "tries": 1,
   "text": "Each one adds one behavior: typed writes, buffering, compression."
  },
  {
   "cue": 19.36,
   "start": 19.36,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.91,
   "tries": 1,
   "text": "Then it passes the bytes on to the stream it wraps."
  },
  {
   "cue": 22.67,
   "start": 22.67,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.43,
   "tries": 1,
   "text": "That is the decorator pattern."
  },
  {
   "cue": 24.56,
   "start": 24.56,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.45,
   "tries": 1,
   "text": "A decorator has the same interface as the object it wraps."
  },
  {
   "cue": 28.22,
   "start": 28.22,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.53,
   "tries": 1,
   "text": "It does one extra thing, and forwards the call."
