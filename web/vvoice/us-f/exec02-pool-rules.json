   "tempo": 1.0,
   "secs": 5.77,
   "tries": 1,
   "text": "Here is a thread pool with two core threads, a maximum of four, and a queue that holds two tasks."
  },
  {
   "cue": 8.97,
   "start": 8.97,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 2.03,
   "tries": 1,
   "text": "Seven tasks arrive, one by one."
  },
  {
   "cue": 11.16,
   "start": 11.16,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.57,
   "tries": 1,
   "text": "Each one takes half a second."
  },
  {
   "cue": 13.22,
   "start": 13.22,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.67,
   "tries": 1,
   "text": "Where does each task go?"
  },
  {
   "cue": 15.73,
   "start": 15.73,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.85,
   "tries": 1,
   "text": "Every call to execute walks the same four rules, in this order."
  },
  {
   "cue": 20.13,
   "start": 20.13,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 0.92,
   "tries": 1,
   "text": "Task one arrives."
  },
  {
   "cue": 21.14,
   "start": 21.2,
   "late": 0.06,
   "tempo": 1.0,
   "secs": 4.04,
   "tries": 1,
   "text": "The pool has fewer threads than core, so rule one starts a new thread for it."
  },
  {
   "cue": 26.43,
   "start": 26.43,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.0,
   "tries": 1,
   "text": "Task two also gets a new thread."
  },
  {
   "cue": 28.65,
   "start": 28.65,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.04,
   "tries": 1,
   "text": "Rule one starts one even if another thread is idle."
  },
  {
   "cue": 32.5,
   "start": 32.5,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 2.49,
   "tries": 1,
   "text": "Task three. The pool is at core size now."
  },
  {
   "cue": 35.15,
   "start": 35.15,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 3.65,
   "tries": 1,
   "text": "So rule two offers the task to the queue, and it waits there."
  },
  {
   "cue": 39.7,
   "start": 39.7,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 1.13,
   "tries": 1,
   "text": "Task four waits too."
  },
  {
   "cue": 41.03,
   "start": 41.03,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 1.29,
   "tries": 1,
   "text": "Now the queue is full."
  },
  {
   "cue": 42.97,
   "start": 42.97,
   "late": 0.0,
   "tempo": 1.15,
   "secs": 1.75,
   "tries": 1,
   "text": "Task five. The queue says no."
  },
  {
   "cue": 44.86,
   "start": 44.87,
   "late": 0.0,
   "tempo": 1.0,
   "secs": 5.14,
   "tries": 1,
   "text": "Rule three starts an extra thread, because three threads is within the max of four."
